# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line

# Create RC corner
create_rc_corner -name RC -qx_tech_file {/usr/cadtool/GPDK45/gsclib045_svt_v4.4/gsclib045/qrc/qx/gpdk045.tch}

# Load timing library and signal integrity library
create_library_set -name lib_max -timing {/usr/cadtool/GPDK45/gsclib045_svt_v4.4/gsclib045/lib/slow_vdd1v2_basicCells.lib} \
    -si {/usr/cadtool/GPDK45/gsclib045_svt_v4.4/gsclib045/celtic/slow.cdb}
create_library_set -name lib_min -timing {/usr/cadtool/GPDK45/gsclib045_svt_v4.4/gsclib045/lib/fast_vdd1v2_basicCells.lib} \
    -si {/usr/cadtool/GPDK45/gsclib045_svt_v4.4/gsclib045/celtic/fast.cdb}

# Specify constraint mode
create_constraint_mode -name CN_func -sdc_files {../pre_layout/IEC_top_syn.sdc}

# Specify delay corners
create_delay_corner -name DC_max -library_set {lib_max} -rc_corner {RC}
create_delay_corner -name DC_min -library_set {lib_min} -rc_corner {RC}

# Specify analysis view
create_analysis_view -name AV_max -constraint_mode {CN_func} -delay_corner {DC_max}
create_analysis_view -name AV_min -constraint_mode {CN_func} -delay_corner {DC_min}

# Set timing analysis view
set_analysis_view -setup {AV_max} -hold {AV_min}
